PORT=5000
NODE_ENV=development

# ── Upstream services ─────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:5001
MAIL_SERVICE_URL=http://localhost:5002

# Zone services mapped by pin_code (JSON object)
ZONE_SERVICES={"700091":"http://localhost:6001","110001":"http://localhost:6002"}

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret forwarded to every internal service via x-api-key header.
# All services must have the same value set as their API_KEY env variable.
INTERNAL_API_KEY=supersecretkey_change_me_in_production

# JWT secret — must match the value used when tokens were signed
JWT_SECRET=supersecret_change_me_in_production
