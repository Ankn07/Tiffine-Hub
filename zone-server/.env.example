NODE_ENV=development
PORT=6001

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/zone-db

# Must match INTERNAL_API_KEY on the API Gateway
API_KEY=supersecretkey_change_me_in_production

# JWT_SECRET — no longer required for auth (gateway handles it).
# Only needed if this service issues its own tokens internally.
# JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=7d

# Administrator (from ENV — not stored in DB)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_OTP_SECRET=your_otp_secret_here

# External microservices (only needed for direct inter-service calls)
MAIL_SERVICE_URL=http://localhost:5002
AUTH_SERVICE_URL=http://localhost:5001
